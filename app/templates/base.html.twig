<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>{% block title %}MOA{% endblock %}</title>

    {% block stylesheets %}
    {% endblock %}

    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}
</head>
<body class="d-flex flex-column min-vh-100">
{% include 'layout/_header.html.twig' %}

<div class="d-flex flex-grow-1">
    {% include 'layout/_sidebar.html.twig' %}

    <main class="flex-grow-1">
        {% block body %}{% endblock %}
    </main>
</div>

{% include 'layout/_footer.html.twig' %}

{% set frankenphp_hot_reload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
{% if frankenphp_hot_reload %}
    <meta name="frankenphp-hot-reload:url" content="{{ frankenphp_hot_reload }}">
    <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
    <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
{% endif %}
</body>
</html>
