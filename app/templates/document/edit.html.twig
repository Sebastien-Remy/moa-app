{% extends 'base.html.twig' %}

{% block title %}Edit document | MOA{% endblock %}

{% block body %}
    <div class="container-fluid py-4">
        <twig:PageHeader
            :breadcrumb="[
                {
                    label: 'Documents',
                    href: path('app_document_index')
                },
                {
                    label: document.displayName,
                    href: path('app_document_show', { id: document.id })
                },
                {
                    label: 'Edit'
                }
            ]"
            title="Edit document"
            description="{{ document.displayName }}"
        />

        <div class="row g-4">
            <div class="col-12 col-xl-5">
                <div class="form-shell">
                    <twig:ExpandableCard
                        id="document-information"
                        title="Document information"
                        description="Edit document metadata and classification."
                        :expanded="true"
                    >
                        <twig:block name="content">
                            {{ form_start(form) }}

                            <div class="row g-3">
                                <div class="col-12 col-md-6">
                                    {{ form_row(form.issuedAt) }}
                                </div>

                                <div class="col-12 col-md-6">
                                    {{ form_row(form.direction) }}
                                </div>

                                <div class="col-12">
                                    {{ form_row(form.reference) }}
                                </div>

                                <div class="col-12 col-md-6">
                                    {{ form_row(form.thirdParty) }}
                                </div>

                                <div class="col-12 col-md-6">
                                    {{ form_row(form.folder) }}
                                </div>

                                <div class="col-12 col-md-6">
                                    {{ form_row(form.documentType) }}
                                </div>

                                <div class="col-12 col-md-6">
                                    {{ form_row(form.status) }}
                                </div>

                                <div class="col-12 col-md-6">
                                    {{ form_row(form.totalAmount) }}
                                </div>

                                <div class="col-12">
                                    {{ form_row(form.tags) }}
                                </div>

                                <div class="col-12 col-md-6">
                                    {{ form_row(form.validFrom) }}
                                </div>

                                <div class="col-12 col-md-6">
                                    {{ form_row(form.validUntil) }}
                                </div>

                                <div class="col-12">
                                    {{ form_row(form.notes) }}
                                </div>
                            </div>

                            <div class="form-actions">
                                <a
                                    href="{{ path('app_document_index') }}"
                                    class="btn btn-outline-secondary"
                                >
                                    Cancel
                                </a>

                                <button
                                    type="submit"
                                    class="btn btn-primary"
                                >
                                    Save
                                </button>
                            </div>

                            {{ form_end(form) }}
                        </twig:block>
                    </twig:ExpandableCard>

                    <twig:ExpandableCard
                        id="third-party-position"
                        title="Third party position"
                        description="Track payables and receivables linked to this document."
                        :expanded="true"
                    >
                        <twig:block name="actions">
                            <a
                                href="{{ path('app_document_third_party_entry_new', { id: document.id }) }}"
                                class="btn btn-sm btn-primary"
                            >
                                <i class="fa-solid fa-plus me-1"></i>
                                Add entry
                            </a>
                        </twig:block>

                        <twig:block name="content">
                            <twig:DataTable
                                :rows="thirdPartyEntryRows"
                                emptyMessage="No third party entries yet."
                            >
                                <twig:block name="header">
                                    <tr>
                                        <th>Date</th>
                                        <th>Third party</th>
                                        <th>Position</th>
                                        <th class="text-end">Amount</th>
                                    </tr>
                                </twig:block>

                                <twig:block name="body">
                                    {% for row in thirdPartyEntryRows %}
                                        {% set entry = row.entry %}
                                        {% set position = row.position %}

                                        <tr>
                                            <td>
                                                {{ entry.entryDate|date('d/m/Y') }}
                                            </td>

                                            <td>
                                                {{ entry.thirdParty.displayName }}
                                            </td>

                                            <td>
                                                <span class="{{ position.colorClass }}">
                                                    <i class="{{ position.icon }} me-1"></i>
                                                    {{ position.label }}
                                                </span>
                                            </td>

                                            <td class="text-end">
                                                {{ row.formattedAmount ?? '—' }}
                                            </td>
                                            <td class="text-end">
                                                <twig:TableActions>
                                                    <twig:block name="content">
                                                        <twig:ActionButton
                                                            :href="path(
                                                                'app_document_third_party_entry_edit',
                                                                {

                                                                    documentId: document.id,
                                                                    id: entry.id
                                                                }
                                                            )"
                                                            title="Edit entry"
                                                            icon="fa-solid fa-pen"
                                                        />

                                                        <twig:ActionForm
                                                            :action="path(
                                                                'app_document_third_party_entry_delete',
                                                                {
                                                                    documentId: document.id,
                                                                    id: entry.id
                                                                }
                                                            )"
                                                            csrfTokenId="delete-third-party-entry-{{ entry.id }}"
                                                            title="Delete entry"
                                                            icon="fa-solid fa-trash"
                                                            variant="btn-outline-danger"
                                                            confirmMessage="Delete this third party entry?"
                                                        />
                                                    </twig:block>
                                                </twig:TableActions>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </twig:block>
                            </twig:DataTable>
                        </twig:block>
                    </twig:ExpandableCard>

                    <twig:ExpandableCard
                        id="financial-analysis"
                        title="Financial analysis"
                        description="Allocate this document to categories and analytical dimensions."
                        :expanded="true"
                    >
                        <twig:block name="actions">
                            <a
                                href="{{ path('app_document_analysis_new', { id: document.id }) }}"
                                class="btn btn-sm btn-primary"
                            >
                                <i class="fa-solid fa-plus me-1"></i>
                                Add analysis
                            </a>
                        </twig:block>
                        <twig:block name="content">
                            <twig:DataTable
                                :rows="analysisRows"
                                emptyMessage="No analysis entries yet."
                            >
                                <twig:block name="header">
                                    <tr>
                                        <th>Date</th>
                                        <th>Category</th>
                                        <th class="text-end">Amount</th>
                                    </tr>
                                </twig:block>

                                <twig:block name="body">
                                    {% for row in analysisRows %}
                                        {% set analysis = row.analysis %}

                                        <tr>
                                            <td>
                                                {{ analysis.analysisDate|date('d/m/Y') }}
                                            </td>
                                            <td>
                                                {{ analysis.category ? analysis.category.displayName : '—' }}
                                            </td>
                                            <td class="text-end">
                                                {{ row.formattedAmount ?? '—' }}
                                            </td>
                                            <td class="text-end">
                                                <twig:TableActions>
                                                    <twig:block name="content">
                                                        <twig:ActionButton
                                                            :href="path('app_document_analysis_edit',
                                                                {
                                                                    documentId: document.id,
                                                                    id: analysis.id
                                                                }
                                                            )"
                                                            title="Edit analysis"
                                                            icon="fa-solid fa-pen"
                                                        />
                                                        <twig:ActionForm
                                                            :action="path('app_document_analysis_delete',
                                                                {
                                                                    documentId: document.id,
                                                                    id: analysis.id
                                                                }
                                                            )"
                                                            csrfTokenId="delete-analysis-{{ analysis.id }}"
                                                            title="Delete analysis"
                                                            icon="fa-solid fa-trash"
                                                            variant="btn-outline-danger"
                                                            confirmMessage="Delete this analysis?"
                                                        />
                                                    </twig:block>
                                                </twig:TableActions>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </twig:block>
                            </twig:DataTable>
                        </twig:block>
                    </twig:ExpandableCard>
                </div>
            </div>

            <div class="col-12 col-xl-7">
                <twig:PdfPreview
                    :src="path('app_document_file', { id: document.id })"
                    title="Document preview"
                />
            </div>
        </div>
    </div>
{% endblock %}
