{% extends 'base.html.twig' %}

{% block title %}Edit document | MOA{% endblock %}

{% block body %}
    <div class="container-fluid py-4">
        <twig:PageHeader
            :breadcrumb="[
                {
                    label: 'Documents',
                    href: path('app_document_index')
                },
                {
                    label: document.displayName,
                    href: path('app_document_show', { id: document.id })
                },
                {
                    label: 'Edit'
                }
            ]"
            title="Edit document"
            description="{{ document.displayName }}"
        />

        <div class="row g-4">
            <div class="col-12 col-xl-5">
                <div class="form-shell">
                    {% include 'document/edit/_document_model.html.twig' %}
                    {% include 'document/edit/_information.html.twig' %}
                    {% include 'document/edit/_third_party_position.html.twig' %}
                    {% include 'document/edit/_financial_analysis.html.twig' %}
                </div>
            </div>

            <div class="col-12 col-xl-7">
                <twig:PdfPreview
                    :src="path('app_document_file', { id: document.id })"
                    title="Document preview"
                />
            </div>
        </div>
    </div>
{% endblock %}
