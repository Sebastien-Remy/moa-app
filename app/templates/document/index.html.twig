{% extends 'base.html.twig' %}

{% block title %}Documents | MOA{% endblock %}

{% block body %}
    <div class="container-fluid py-4">
        {% set actions %}
            <a
                href="{{ path('app_document_import') }}"
                class="btn btn-primary"
            >
                <i class="fa-solid fa-file-import me-2"></i>
                Import document
            </a>
        {% endset %}
        <twig:PageHeader
            title="Documents"
            description="Browse and manage your documents."
            :actions="actions"
        />
        <form

            method="get"

            class="mb-4"

        >

            <div class="input-group">

        <span class="input-group-text">

            <i class="fa-solid fa-magnifying-glass"></i>

        </span>

                <input

                    type="search"

                    name="search"

                    class="form-control"

                    placeholder="Search by reference..."

                    value="{{ search }}"

                >

                <button

                    type="submit"

                    class="btn btn-primary"

                >

                    Search

                </button>

                {% if search %}

                    <a

                        href="{{ path('app_document_index') }}"

                        class="btn btn-outline-secondary"

                    >

                        Clear

                    </a>

                {% endif %}

            </div>

        </form>
        <twig:DataTable
            :rows="rows"
            emptyMessage="No documents found."
        >
            <twig:block name="header">
                <tr>
                    <th>Date</th>
                    <th>Third party</th>
                    <th>Reference</th>
                    <th>Folder</th>
                    <th>Status</th>
                    <th class="text-end">Amount</th>
                    <th class="text-end">Actions</th>
                </tr>
            </twig:block>

            <twig:block name="body">
                {% for row in rows %}
                    {% set document = row.document %}

                    <tr>
                        <td>
                            {% if document.issuedAt %}
                                {{ document.issuedAt|date('Y-m-d') }}
                            {% else %}
                                —
                            {% endif %}
                        </td>
                        <td>{{ document.thirdParty ?? '—' }}</td>
                        <td>{{ document.reference ?? '—' }}</td>
                        <td>{{ document.folder ?? '—' }}</td>
                        <td>{{ document.status ?? '—' }}</td>
                        <td class="text-end">
                            {{ row.formattedAmount ?? '—' }}
                        </td>
                        <td class="text-end">
                            <twig:TableActions>
                                <twig:ActionButton
                                    href="{{ path('app_document_show', { id: document.id }) }}"
                                    icon="fa-regular fa-file-pdf"
                                    title="View document"
                                />
                                <twig:ActionButton
                                    href="{{ path('app_document_edit', { id: document.id }) }}"
                                    icon="fa-regular fa-pen-to-square"
                                    title="Edit document"
                                />
                                <twig:ActionForm
                                    action="{{ path('app_document_delete', { id: document.id }) }}"
                                    csrfTokenId="delete-document-{{ document.id }}"
                                    icon="fa-solid fa-trash"
                                    title="Delete document"
                                    confirmMessage="Delete this document?"
                                />
                            </twig:TableActions>
                        </td>
                    </tr>
                {% endfor %}
            </twig:block>
        </twig:DataTable>
        {% if pagination.totalPages > 1 %}
            <nav
                class="d-flex justify-content-between align-items-center mt-4"
                aria-label="Document pagination"
            >
                <div class="text-body-secondary small">
                    {{ pagination.total }}
                    document{{ pagination.total > 1 ? 's' : '' }}

                    • Page {{ pagination.page }}
                    / {{ pagination.totalPages }}
                </div>

                <ul class="pagination mb-0">

                    <li class="page-item{% if pagination.page == 1 %} disabled{% endif %}">
                        <a
                            class="page-link"
                            href="{{ path('app_document_index', {
                                page: pagination.page - 1,
                                search: search
                            }) }}"
                        >
                            Previous
                        </a>
                    </li>

                    {% for page in 1..pagination.totalPages %}
                        <li class="page-item{% if page == pagination.page %} active{% endif %}">
                            <a
                                class="page-link"
                                href="{{ path('app_document_index', {
                                    page: page,
                                    search: search
                                }) }}"
                            >
                                {{ page }}
                            </a>
                        </li>
                    {% endfor %}

                    <li class="page-item{% if pagination.page == pagination.totalPages %} disabled{% endif %}">
                        <a
                            class="page-link"
                            href="{{ path('app_document_index', {
                                page: pagination.page + 1,
                                search: search
                            }) }}"
                        >
                            Next
                        </a>
                    </li>

                </ul>
            </nav>
        {% endif %}
    </div>
{% endblock %}
