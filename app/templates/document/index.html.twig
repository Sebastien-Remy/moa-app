{% extends 'base.html.twig' %}

{% block title %}Documents | MOA{% endblock %}

{% block body %}
    <div class="container-fluid py-4">
        {% set actions %}
            <a
                href="{{ path('app_document_import') }}"
                class="btn btn-primary"
            >
                <i class="fa-solid fa-file-import me-2"></i>
                Import document
            </a>
        {% endset %}

        <twig:PageHeader
            title="Documents"
            description="Browse and manage your documents."
            :actions="actions"
        />

        {% set filtersActive =
            folder
            or thirdParty
            or status
            or model
            or dateFrom
            or dateTo
        %}

        <div class="form-card mb-4">
            <div class="mb-4">
                <h2 class="h5 mb-1">
                    Search
                </h2>

                <p class="text-body-secondary mb-0">
                    Search documents by reference.
                </p>
            </div>

            <form method="get">
                {% if folder %}
                    <input
                        type="hidden"
                        name="folder"
                        value="{{ folder }}"
                    >
                {% endif %}

                {% if thirdParty %}
                    <input
                        type="hidden"
                        name="thirdParty"
                        value="{{ thirdParty }}"
                    >
                {% endif %}

                {% if status %}
                    <input
                        type="hidden"
                        name="status"
                        value="{{ status }}"
                    >
                {% endif %}

                {% if model %}
                    <input
                        type="hidden"
                        name="model"
                        value="{{ model }}"
                    >
                {% endif %}

                {% if dateFrom %}
                    <input
                        type="hidden"
                        name="dateFrom"
                        value="{{ dateFrom }}"
                    >
                {% endif %}

                {% if dateTo %}
                    <input
                        type="hidden"
                        name="dateTo"
                        value="{{ dateTo }}"
                    >
                {% endif %}

                <div class="input-group">
                    <span class="input-group-text">
                        <i class="fa-solid fa-magnifying-glass"></i>
                    </span>

                    <input
                        id="search"
                        type="search"
                        name="search"
                        class="form-control"
                        placeholder="Search by reference..."
                        value="{{ search }}"
                    >

                    <button
                        type="submit"
                        class="btn btn-primary"
                    >
                        Search
                    </button>

                    {% if search %}
                        <a
                            href="{{ path('app_document_index', {
                                folder: folder,
                                thirdParty: thirdParty,
                                status: status,
                                model: model,
                                dateFrom: dateFrom,
                                dateTo: dateTo
                            }) }}"
                            class="btn btn-outline-secondary"
                        >
                            Clear
                        </a>
                    {% endif %}
                </div>
            </form>

            <div class="border-top mt-4 pt-3">
                <button
                    type="button"
                    class="btn btn-link px-0 text-decoration-none"
                    data-bs-toggle="collapse"
                    data-bs-target="#document-filters"
                    aria-expanded="{{ filtersActive ? 'true' : 'false' }}"
                    aria-controls="document-filters"
                >
                    <i class="fa-solid fa-filter me-2"></i>
                    Filters

                    {% if filtersActive %}
                        <span class="badge text-bg-primary ms-1">
                            Active
                        </span>
                    {% endif %}

                    <i class="fa-solid fa-chevron-down ms-2"></i>
                </button>

                <div
                    id="document-filters"
                    class="collapse{% if filtersActive %} show{% endif %}"
                >
                    <form
                        method="get"
                        class="pt-3"
                    >
                        {% if search %}
                            <input
                                type="hidden"
                                name="search"
                                value="{{ search }}"
                            >
                        {% endif %}

                        <div class="row g-3">
                            <div class="col-12 col-md-3">
                                <label
                                    for="folder"
                                    class="form-label"
                                >
                                    Folder
                                </label>

                                <select
                                    id="folder"
                                    name="folder"
                                    class="form-select"
                                >
                                    <option value="">
                                        All folders
                                    </option>

                                    {% for item in folders %}
                                        <option
                                            value="{{ item.id }}"
                                            {% if folder == item.id %}
                                                selected
                                            {% endif %}
                                        >
                                            {{ item.name }}
                                        </option>
                                    {% endfor %}
                                </select>
                            </div>

                            <div class="col-12 col-md-3">
                                <label
                                    for="thirdParty"
                                    class="form-label"
                                >
                                    Third party
                                </label>

                                <select
                                    id="thirdParty"
                                    name="thirdParty"
                                    class="form-select"
                                >
                                    <option value="">
                                        All third parties
                                    </option>

                                    {% for item in thirdParties %}
                                        <option
                                            value="{{ item.id }}"
                                            {% if thirdParty == item.id %}
                                                selected
                                            {% endif %}
                                        >
                                            {{ item.name }}
                                        </option>
                                    {% endfor %}
                                </select>
                            </div>

                            <div class="col-12 col-md-3">
                                <label
                                    for="status"
                                    class="form-label"
                                >
                                    Status
                                </label>

                                <select
                                    id="status"
                                    name="status"
                                    class="form-select"
                                >
                                    <option value="">
                                        All statuses
                                    </option>

                                    {% for item in statuses %}
                                        <option
                                            value="{{ item.id }}"
                                            {% if status == item.id %}
                                                selected
                                            {% endif %}
                                        >
                                            {{ item.name }}
                                        </option>
                                    {% endfor %}
                                </select>
                            </div>

                            <div class="col-12 col-md-3">
                                <label
                                    for="model"
                                    class="form-label"
                                >
                                    Model
                                </label>

                                <select
                                    id="model"
                                    name="model"
                                    class="form-select"
                                >
                                    <option value="">
                                        All documents
                                    </option>

                                    <option
                                        value="1"
                                        {% if model == '1' %}
                                            selected
                                        {% endif %}
                                    >
                                        Models only
                                    </option>

                                    <option
                                        value="0"
                                        {% if model == '0' %}
                                            selected
                                        {% endif %}
                                    >
                                        Non-models only
                                    </option>
                                </select>
                            </div>

                            <div class="col-12 col-md-3">
                                <label
                                    for="dateFrom"
                                    class="form-label"
                                >
                                    Date from
                                </label>

                                <input
                                    id="dateFrom"
                                    type="date"
                                    name="dateFrom"
                                    class="form-control"
                                    value="{{ dateFrom }}"
                                >
                            </div>

                            <div class="col-12 col-md-3">
                                <label
                                    for="dateTo"
                                    class="form-label"
                                >
                                    Date to
                                </label>

                                <input
                                    id="dateTo"
                                    type="date"
                                    name="dateTo"
                                    class="form-control"
                                    value="{{ dateTo }}"
                                >
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-4">
                            {% if filtersActive %}
                                <a
                                    href="{{ path('app_document_index', {
                                        search: search
                                    }) }}"
                                    class="btn btn-outline-secondary"
                                >
                                    Clear filters
                                </a>
                            {% endif %}

                            <button
                                type="submit"
                                class="btn btn-primary"
                            >
                                Apply filters
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <twig:DataTable
            :rows="rows"
            emptyMessage="No documents found."
        >
            <twig:block name="header">
                <tr>
                    <th>Date</th>
                    <th>Reference</th>
                    <th>Folder</th>
                    <th>Third party</th>
                    <th>Status</th>
                    <th class="text-end">Amount</th>
                    <th class="text-end">Actions</th>
                </tr>
            </twig:block>

            <twig:block name="body">
                {% for row in rows %}
                    {% set document = row.document %}

                    <tr>
                        <td>
                            {% if document.issuedAt %}
                                {{ document.issuedAt|date('Y-m-d') }}
                            {% else %}
                                —
                            {% endif %}
                        </td>

                        <td>
                            {{ document.reference ?? '—' }}

                            {% if document.isModel %}
                                <i
                                    class="fa-solid fa-copy ms-1 text-body-secondary"
                                    title="{{ document.modelDisplayName }}"
                                    aria-label="Model: {{ document.modelDisplayName }}"
                                ></i>
                            {% endif %}
                        </td>

                        <td>{{ document.folder ?? '—' }}</td>
                        <td>{{ document.thirdParty ?? '—' }}</td>
                        <td>{{ document.status ?? '—' }}</td>

                        <td class="text-end">
                            {{ row.formattedAmount ?? '—' }}
                        </td>

                        <td class="text-end">
                            <twig:TableActions>
                                <twig:ActionButton
                                    href="{{ path('app_document_show', { id: document.id }) }}"
                                    icon="fa-regular fa-file-pdf"
                                    title="View document"
                                />

                                <twig:ActionButton
                                    href="{{ path('app_document_edit', { id: document.id }) }}"
                                    icon="fa-regular fa-pen-to-square"
                                    title="Edit document"
                                />

                                <twig:ActionForm
                                    action="{{ path('app_document_delete', { id: document.id }) }}"
                                    csrfTokenId="delete-document-{{ document.id }}"
                                    icon="fa-solid fa-trash"
                                    title="Delete document"
                                    confirmMessage="Delete this document?"
                                />
                            </twig:TableActions>
                        </td>
                    </tr>
                {% endfor %}
            </twig:block>
        </twig:DataTable>

        <div class="d-flex justify-content-end mt-3">
            <div class="text-end">
                <div class="text-body-secondary small">
                    {{ pagination.total }}
                    document{{ pagination.total > 1 ? 's' : '' }}
                </div>

                <div class="fw-semibold">
                    Total:
                    {{ formattedTotalAmount ?? '—' }}
                </div>
            </div>
        </div>

        {% if pagination.totalPages > 1 %}
            <nav
                class="d-flex justify-content-between align-items-center mt-4"
                aria-label="Document pagination"
            >
                <div class="text-body-secondary small">
                    Page {{ pagination.page }}
                    / {{ pagination.totalPages }}
                </div>

                <ul class="pagination mb-0">
                    <li class="page-item{% if pagination.page == 1 %} disabled{% endif %}">
                        <a
                            class="page-link"
                            href="{{ path('app_document_index', {
                                page: pagination.page - 1,
                                search: search,
                                folder: folder,
                                thirdParty: thirdParty,
                                status: status,
                                model: model,
                                dateFrom: dateFrom,
                                dateTo: dateTo
                            }) }}"
                        >
                            Previous
                        </a>
                    </li>

                    {% for page in 1..pagination.totalPages %}
                        <li class="page-item{% if page == pagination.page %} active{% endif %}">
                            <a
                                class="page-link"
                                href="{{ path('app_document_index', {
                                    page: page,
                                    search: search,
                                    folder: folder,
                                    thirdParty: thirdParty,
                                    status: status,
                                    model: model,
                                    dateFrom: dateFrom,
                                    dateTo: dateTo
                                }) }}"
                            >
                                {{ page }}
                            </a>
                        </li>
                    {% endfor %}

                    <li class="page-item{% if pagination.page == pagination.totalPages %} disabled{% endif %}">
                        <a
                            class="page-link"
                            href="{{ path('app_document_index', {
                                page: pagination.page + 1,
                                search: search,
                                folder: folder,
                                thirdParty: thirdParty,
                                status: status,
                                model: model,
                                dateFrom: dateFrom,
                                dateTo: dateTo
                            }) }}"
                        >
                            Next
                        </a>
                    </li>
                </ul>
            </nav>
        {% endif %}
    </div>
{% endblock %}
