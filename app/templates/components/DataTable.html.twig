{% if rows is empty %}
    <div class="border rounded p-4 text-body-secondary">
        {{ emptyMessage|default('No data available.') }}
    </div>
{% else %}
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
            {% block header %}{% endblock %}
            </thead>

            <tbody>
            {% block body %}{% endblock %}
            </tbody>
        </table>
    </div>
{% endif %}
