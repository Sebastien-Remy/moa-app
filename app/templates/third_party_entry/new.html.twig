{% extends 'base.html.twig' %}

{% block title %}New third party entry | MOA{% endblock %}

{% block body %}
    <div class="container-fluid py-4">
        <twig:PageHeader
            :breadcrumb="[
                {
                    label: 'Documents',
                    href: path('app_document_index')
                },
                {
                    label: document.displayName,
                    href: path('app_document_show', { id: document.id })
                },
                {
                    label: 'Edit',
                    href: path('app_document_edit', { id: document.id })
                },
                {
                    label: 'New third party entry'
                }
            ]"
            title="New third party entry"
            description="{{ document.displayName }}"
        />

        <div class="row g-4">
            <div class="col-12 col-xl-5">
                <div class="form-shell">

                    <twig:ExpandableCard
                        id="third-party-entry"
                        title="Third party position"
                        description="Create a payable or receivable entry linked to this document."
                    >
                        {% block content %}

                            {{ form_start(form) }}

                            <div class="row g-3">

                                <div class="col-12">
                                    {{ form_row(form.thirdParty) }}
                                </div>

                                <div class="col-12 col-md-6">
                                    {{ form_row(form.entryDate) }}
                                </div>

                                <div class="col-12 col-md-6">
                                    {{ form_row(form.amountValue) }}
                                </div>

                                <div class="col-12">
                                    {{ form_row(form.position) }}
                                </div>

                                <div class="col-12">
                                    {{ form_row(form.notes) }}
                                </div>

                            </div>

                            <div class="form-actions">
                                <a
                                    href="{{ path('app_document_edit', {
                                        id: document.id
                                    }) }}"
                                    class="btn btn-outline-secondary"
                                >
                                    Cancel
                                </a>

                                <button
                                    type="submit"
                                    class="btn btn-primary"
                                >
                                    Save
                                </button>
                            </div>

                            {{ form_end(form) }}

                        {% endblock %}
                    </twig:ExpandableCard>

                </div>
            </div>

            <div class="col-12 col-xl-7">
                <twig:PdfPreview
                    :src="path('app_document_file', {
                        id: document.id
                    })"
                    title="Document preview"
                />
            </div>
        </div>
    </div>
{% endblock %}
